# Copia a .env, elige valores únicos y no subas ese archivo a Git.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Solo al inicializar un volumen nuevo. El archivo incluido contiene el catálogo y los usuarios originales.
# Para importar una copia local más reciente:
# DB_INIT_SQL=./backups/DecanlysqlNuevo.sql
DB_INIT_SQL=./database/001-schema.sql
# Mantén false al importar el catálogo incluido: ya contiene usuarios.
BOOTSTRAP_ADMIN=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true para una URL HTTPS. false solo para pruebas locales por HTTP.
COOKIE_SECURE=true
